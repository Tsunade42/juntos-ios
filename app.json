{
  "expo": {
    "name": "Juntos",
    "slug": "juntos",
    "version": "1.4.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0f14",
    "ios": {
      "bundleIdentifier": "com.appr.juntos",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Juntos usa el micrófono para el chat de voz de las salas.",
        "NSCameraUsageDescription": "Juntos usa la cámara si quieres tomar una foto para el chat o tu perfil.",
        "NSPhotoLibraryUsageDescription": "Juntos accede a tus fotos y videos solo para enviarlos al chat o subirlos a una sala.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "usesAppleSignIn": true
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#08101d"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Juntos usa el micrófono para el chat de voz de las salas.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7258575032949973~6999733512",
          "iosAppId": "ca-app-pub-7258575032949973~4342916056",
          "userTrackingUsageDescription": "Juntos usa este permiso para mostrarte anuncios más relevantes. Si no lo permites, verás anuncios igual, pero no personalizados."
        }
      ],
      "expo-iap",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Juntos usa este permiso para mostrarte anuncios más relevantes. Si no lo permites, verás anuncios igual, pero no personalizados."
        }
      ]
    ],
    "extra": {
      "servidor": "https://30.abis.party"
    },
    "android": {
      "package": "com.appr.juntos",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c1830"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "scheme": "juntos"
  }
}
